---
import TablePage from '../components/TablePage.astro';

const tableHeaders = ['Tipo de Contribuinte', 'Alíquota', 'Base de Cálculo', 'Valor Mensal'];

const tableData = [
  ['Contribuinte Individual (20%)', '20%', 'R$ 1.621,00 a R$ 8.157,41', 'R$ 324,20 a R$ 1.631,48'],
  ['Contribuinte Individual (11%)', '11%', 'Salário Mínimo (R$ 1.621,00)', 'R$ 178,31'],
  ['Facultativo (20%)', '20%', 'R$ 1.621,00 a R$ 8.157,41', 'R$ 324,20 a R$ 1.631,48'],
  ['Facultativo (11%)', '11%', 'Salário Mínimo (R$ 1.621,00)', 'R$ 178,31'],
  ['Facultativo Baixa Renda (5%)', '5%', 'Salário Mínimo (R$ 1.621,00)', 'R$ 81,05'],
  ['MEI (via DAS)', '5%', 'Salário Mínimo (R$ 1.621,00)', 'R$ 81,05 + taxas'],
];

const faqItems = [
  {
    question: 'Qual a diferença entre contribuinte individual e facultativo?',
    answer: 'O contribuinte individual exerce atividade remunerada por conta própria (autônomos, empresários). O facultativo não exerce atividade remunerada, mas deseja contribuir para ter direito aos benefícios (estudantes, donas de casa, desempregados).'
  },
  {
    question: 'Posso contribuir com 11% e me aposentar por tempo de contribuição?',
    answer: 'Não. A alíquota de 11% sobre o salário mínimo dá direito apenas à aposentadoria por idade. Para aposentadoria por tempo de contribuição, é necessário contribuir com 20%.'
  },
  {
    question: 'O que é o plano simplificado de 11%?',
    answer: 'É uma forma de contribuição reduzida que dá direito à aposentadoria por idade, auxílio-doença, salário-maternidade e pensão por morte, com valor do benefício de 1 salário mínimo.'
  },
  {
    question: 'Quem pode contribuir como facultativo baixa renda?',
    answer: 'Pessoas de família de baixa renda inscrita no CadÚnico, que não exerçam atividade remunerada e se dediquem exclusivamente ao trabalho doméstico em sua própria residência.'
  },
  {
    question: 'Como pagar a contribuição como autônomo?',
    answer: 'Através da GPS (Guia da Previdência Social), que pode ser gerada no site ou app Meu INSS. O pagamento deve ser feito até o dia 15 do mês seguinte ao da competência.'
  }
];
---

<TablePage
  title="INSS Autônomo 2026: Tabela"
  description="Tabela de contribuição INSS 2026 para contribuintes individuais, autônomos e facultativos. Confira alíquotas de 5%, 11% e 20% e valores atualizados."
  intro="Valores e alíquotas de contribuição para autônomos, profissionais liberais, facultativos e MEI em 2026."
  tableHeaders={tableHeaders}
  tableData={tableData}
  faqItems={faqItems}
  extraContent={true}
>
  <h3>Códigos de Pagamento GPS</h3>
  <ul>
    <li><strong>1007</strong> - Contribuinte Individual - Plano Normal (20%)</li>
    <li><strong>1163</strong> - Contribuinte Individual - Plano Simplificado (11%)</li>
    <li><strong>1406</strong> - Facultativo - Plano Normal (20%)</li>
    <li><strong>1473</strong> - Facultativo - Plano Simplificado (11%)</li>
    <li><strong>1929</strong> - Facultativo Baixa Renda - CadÚnico (5%)</li>
  </ul>
  <p><strong>MEI:</strong> A contribuição é paga via DAS-MEI (não usa GPS). O valor do INSS é R$ 81,05 + R$ 1,00 de ICMS e/ou R$ 5,00 de ISS conforme a atividade.</p>
</TablePage>
