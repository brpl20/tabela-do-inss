---
import TablePage from '../components/TablePage.astro';

const tableHeaders = ['Sigla', 'Significado', 'Descrição'];

const tableData = [
  ['INSS', 'Instituto Nacional do Seguro Social', 'Autarquia responsável pela previdência social'],
  ['RGPS', 'Regime Geral de Previdência Social', 'Sistema previdenciário dos trabalhadores privados'],
  ['RPPS', 'Regime Próprio de Previdência Social', 'Sistema previdenciário dos servidores públicos'],
  ['NIT', 'Número de Identificação do Trabalhador', 'Número de inscrição no INSS'],
  ['PIS', 'Programa de Integração Social', 'Cadastro do trabalhador (setor privado)'],
  ['PASEP', 'Programa de Formação do Patrimônio do Servidor', 'Cadastro do servidor público'],
  ['CNIS', 'Cadastro Nacional de Informações Sociais', 'Base de dados de vínculos e contribuições'],
  ['GPS', 'Guia da Previdência Social', 'Documento para pagamento de contribuições'],
  ['DIB', 'Data de Início do Benefício', 'Data em que o benefício começa a valer'],
  ['DER', 'Data de Entrada do Requerimento', 'Data do pedido do benefício'],
  ['DCB', 'Data de Cessação do Benefício', 'Data em que o benefício é encerrado'],
  ['RMI', 'Renda Mensal Inicial', 'Valor inicial do benefício'],
  ['PPP', 'Perfil Profissiográfico Previdenciário', 'Documento de atividade especial'],
  ['LTCAT', 'Laudo Técnico das Condições Ambientais', 'Laudo de exposição a agentes nocivos'],
  ['BPC', 'Benefício de Prestação Continuada', 'Benefício assistencial (não previdenciário)'],
  ['LOAS', 'Lei Orgânica da Assistência Social', 'Lei que regulamenta o BPC'],
  ['FAP', 'Fator Acidentário de Prevenção', 'Multiplicador do RAT para empresas'],
  ['RAT', 'Risco Ambiental do Trabalho', 'Contribuição sobre risco de acidentes'],
  ['SAT', 'Seguro Acidente de Trabalho', 'Antigo nome do RAT'],
  ['CTC', 'Certidão de Tempo de Contribuição', 'Documento para averbação de tempo'],
];

const faqItems = [
  {
    question: 'Qual a diferença entre PIS e NIT?',
    answer: 'O PIS é atribuído ao trabalhador pelo empregador no primeiro emprego. O NIT é usado por contribuintes individuais e facultativos que se inscrevem diretamente no INSS. Ambos funcionam como número de identificação.'
  },
  {
    question: 'O que é o CNIS e como acessar?',
    answer: 'O CNIS é a base de dados do INSS com todo seu histórico de trabalho e contribuições. Você pode consultar pelo app ou site Meu INSS, na opção "Extrato de Contribuição (CNIS)".'
  },
  {
    question: 'O que significa DIB, DER e DCB?',
    answer: 'DER é a data do pedido do benefício. DIB é quando o benefício começa a valer (pode ser retroativo). DCB é quando o benefício termina, se for temporário.'
  },
  {
    question: 'Qual a diferença entre RGPS e RPPS?',
    answer: 'RGPS é o regime do INSS para trabalhadores da iniciativa privada. RPPS são os regimes próprios de servidores públicos (federal, estadual, municipal). Têm regras diferentes.'
  },
  {
    question: 'O que é PPP e quando preciso dele?',
    answer: 'O PPP é um documento que comprova exposição a agentes nocivos para aposentadoria especial. Deve ser fornecido pela empresa ao trabalhador. É obrigatório para quem quer converter tempo especial ou pedir aposentadoria especial.'
  }
];
---

<TablePage
  title="Tabela de Siglas do INSS 2026"
  description="Glossário completo de siglas do INSS. Entenda o significado de NIT, PIS, CNIS, GPS, DIB, DER, PPP e outras siglas da previdência."
  intro="Glossário com as principais siglas e termos utilizados pelo INSS e na previdência social brasileira."
  tableHeaders={tableHeaders}
  tableData={tableData}
  faqItems={faqItems}
  extraContent={false}
/>
