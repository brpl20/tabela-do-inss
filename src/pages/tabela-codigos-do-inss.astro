---
import TablePage from '../components/TablePage.astro';

const title = 'Tabela de Códigos do INSS (GPS) 2026';
const description = 'Tabela de códigos de pagamento do INSS (GPS) para 2026: contribuinte individual, facultativo, baixa renda e MEI, com alíquotas, base e observações.';
const intro = 'Referência rápida dos códigos de pagamento (GPS) mais usados para contribuição ao INSS em 2026. Valores calculados com salário mínimo de R$ 1.621,00.';

const tableHeaders = ['Código', 'Categoria', 'Plano', 'Alíquota', 'Base de Cálculo', 'Observações'];

const tableData = [
  ['1007', 'Contribuinte Individual', 'Plano Normal', '20%', 'R$ 1.621,00 a R$ 8.157,41', 'Direito a todos os benefícios'],
  ['1163', 'Contribuinte Individual', 'Plano Simplificado', '11%', 'Somente salário mínimo', 'Sem aposentadoria por tempo; consultar complemento'],
  ['1406', 'Facultativo', 'Plano Normal', '20%', 'R$ 1.621,00 a R$ 8.157,41', 'Sem renda; todos os benefícios'],
  ['1473', 'Facultativo', 'Plano Simplificado', '11%', 'Somente salário mínimo', 'Benefícios básicos; sem tempo de contribuição'],
  ['1929', 'Facultativo Baixa Renda', '—', '5%', 'Somente salário mínimo', 'Requer CadÚnico; dedicação ao lar'],
  ['MEI (DAS)', 'MEI', '—', '5%', 'Somente salário mínimo', 'Não usa GPS; pago via DAS-MEI'],
];

const faqItems = [
  {
    question: 'Qual a diferença entre Contribuinte Individual e Facultativo?',
    answer: 'Contribuinte Individual exerce atividade remunerada por conta própria (autônomos, profissionais liberais). Facultativo não possui renda de trabalho e contribui de forma voluntária (estudantes, donas de casa, desempregados).'
  },
  {
    question: 'Plano Simplificado (11%) dá direito à aposentadoria por tempo?',
    answer: 'Não. O plano simplificado de 11% (códigos 1163 e 1473) não dá direito à aposentadoria por tempo de contribuição. Para esse direito, utilize 20% no plano normal.'
  },
  {
    question: 'Quem pode usar o código 1929 (5%)?',
    answer: 'Facultativo de baixa renda, maior de 16 anos, sem atividade remunerada, inscrito e com dados atualizados no CadÚnico, que se dedique ao trabalho doméstico no próprio lar.'
  },
  {
    question: 'MEI usa código de GPS?',
    answer: 'Não. O MEI paga INSS dentro do DAS-MEI (5% do salário mínimo mais tributos municipais/estaduais conforme CNAE). Não se usa GPS para a contribuição mensal do MEI.'
  },
  {
    question: 'Qual o vencimento da GPS?',
    answer: 'Até o dia 15 do mês seguinte à competência. Se cair em fim de semana/feriado, no próximo dia útil.'
  }
];
---

<TablePage
  title={title}
  description={description}
  intro={intro}
  tableHeaders={tableHeaders}
  tableData={tableData}
  faqItems={faqItems}
  extraContent={true}
>
  <h3>Valores de Referência 2026</h3>
  <ul>
    <li><strong>Salário mínimo:</strong> R$ 1.621,00</li>
    <li><strong>Teto do INSS (referência 2025):</strong> R$ 8.157,41 (aguardando atualização oficial 2026)</li>
    <li><strong>Exemplos no mínimo:</strong> 20% = R$ 324,20 | 11% = R$ 178,31 | 5% = R$ 81,05</li>
  </ul>

  <p><strong>Observação:</strong> Alguns cenários permitem complemento para quem recolhe 11% e deseja contar tempo de contribuição. Verifique o código de complemento vigente antes de efetuar o pagamento.</p>
</TablePage>