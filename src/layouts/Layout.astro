---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

const {
  title = 'Tabela do INSS 2026',
  description = 'Tabela do INSS 2026 atualizada. Confira as aliquotas de contribuicao, faixas salariais e valores do INSS para empregados, autonomos e contribuintes individuais.',
  canonicalURL = Astro.url,
  image = '/og-image.jpg',
  imageAlt = 'Tabela do INSS 2026',
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
  robots = 'index, follow'
} = Astro.props;

const siteTitle = title.includes('Tabela do INSS') ? title : `${title} | Tabela do INSS 2026`;
const siteUrl = Astro.site ?? new URL('/', canonicalURL).origin;
const ogImage = image?.startsWith('http') ? image : new URL(image, siteUrl).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Tabela do INSS" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Tabela do INSS 2026" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Fonts - carregadas sem bloquear a primeira pintura.
         O body ja cai em system-ui enquanto a Inter nao chega. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </noscript>

    <!-- Google tag (gtag.js) - com consent mode -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WDFK38WEFT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      gtag('consent', 'default', {
        'analytics_storage': 'denied'
      });

      gtag('js', new Date());
      gtag('config', 'G-WDFK38WEFT', { anonymize_ip: true });

      if (localStorage.getItem('cookie-consent') === 'accepted') {
        gtag('consent', 'update', {
          'analytics_storage': 'granted'
        });
      }
    </script>

    <script>
      var ahrefs_analytics_script = document.createElement('script');
      ahrefs_analytics_script.async = true;
      ahrefs_analytics_script.src = 'https://analytics.ahrefs.com/analytics.js';
      ahrefs_analytics_script.setAttribute('data-key', 'H9/ae1AFK/IxxqlwXoCCxA');
      document.getElementsByTagName('head')[0].appendChild(ahrefs_analytics_script);
    </script>

    <!-- Microsoft Clarity - so carrega apos consentimento explicito (LGPD) -->
    <script is:inline>
      window.loadClarity = function () {
        if (window.__clarityLoaded) return;
        window.__clarityLoaded = true;
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "wqguwujtv7");
      };

      if (localStorage.getItem('cookie-consent') === 'accepted') {
        window.loadClarity();
      }
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    font-family: 'Inter', system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #f8f9fa;
    color: #1a1a1a;
    line-height: 1.6;
  }

  main {
    flex: 1;
  }

  a {
    color: #1a5f2a;
  }

  a:hover {
    color: #0d4a1e;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  h1, h2, h3, h4, h5, h6 {
    line-height: 1.3;
    margin-top: 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
